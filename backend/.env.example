# 阿里云 PostgreSQL 连接串
# 用 psycopg3(SQLAlchemy 2.0 原生支持,无需 pg_config)
# 格式:postgresql+psycopg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+psycopg://username:password@pgm-xxx.pg.rds.aliyuncs.com:5432/agentpair
# 启动时是否 drop_all + create_all 重建表(会清空数据)
# 默认 false:仅 create_all 幂等建表,数据保留
# schema 变更时临时设为 true,改完记得改回 false
DB_REBUILD_ON_START=false

# 应用配置
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
# 日志级别(DEBUG/INFO/WARNING/ERROR),留空则按 APP_DEBUG 决定
# 排查 Qoder CLI 认证等问题时建议设为 DEBUG,能看到 bridge 日志增量等诊断输出
LOG_LEVEL=

# JWT 密钥(阶段 6 用,先占位)
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 应用基础 URL(用于邮件中的验证/重置链接)
APP_BASE_URL=http://localhost:5173

# GitHub OAuth(阶段 6 用,留空则 /auth/oauth/github 报错)
# 在 https://github.com/settings/developers 创建 OAuth App 获取
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/auth/github/callback

# LLM 配置(阶段 1:开发期写死一个 provider,阶段 6 起用户可配)
# provider id,对应 models_catalog.json 中的 llmProviders[].id
LLM_PROVIDER=dashscope
# API Key(从厂商控制台获取)
LLM_API_KEY=sk-xxxxx
# 模型 id,对应 models_catalog.json 中的 models[].id
LLM_MODEL=qwen3.6-flash
# 是否启用思考(混合思考模型可开关,仅思考模型强制开启)
LLM_ENABLE_THINKING=true

# 仓库克隆临时目录(阶段 1:本地 clone,阶段 2 起改沙箱)
REPO_CLONE_DIR=./_repos

# 沙箱配置(阶段 2 起)
# mode: mock(本地未部署 Server,用本地文件系统模拟)/ sandbox(连真实 OpenSandbox Server)
SANDBOX_MODE=mock
# OpenSandbox Server 地址(部署在 Linux 服务器上)
# 形如 http://your-server-ip:8080
SANDBOX_SERVER_URL=http://localhost:8080
# Server 鉴权 API Key(对应 server 配置 [server].api_key,留空则不鉴权)
SANDBOX_API_KEY=
# 沙箱镜像:必须预装 git / ripgrep(rg) / python3 / awk / coreutils
# 官方 ubuntu 镜像不含 git 和 rg,需按 docs/opensandbox-deploy.md 构建自定义镜像
SANDBOX_IMAGE=ubuntu
# 沙箱超时(分钟)
SANDBOX_TIMEOUT_MINUTES=30
# 是否走 Server 代理访问沙箱(跨机部署必须为 true;本机部署 true 也能用)
# true=所有沙箱请求经 Server 8080 转发,后端只需连 Server 一个端口
# false=SDK 直连沙箱容器端口(需后端能访问 Server 容器端口范围)
SANDBOX_USE_SERVER_PROXY=true
# Server 宿主机上的 SSH key 目录(可选,只读挂载到沙箱 /home/user/.ssh 供 git clone SSH 协议用)
# 这是 Server 机器上的路径,不是后端本地路径!必须用绝对路径(如 /home/admin/.ssh),不要用 ~
# 留空不挂载;需在 server [storage].allowed_host_paths 放行该路径前缀
SANDBOX_SSH_KEY_HOST_PATH=
# 沙箱资源限制(可选,传给 SDK resource 参数,如 cpu=2 memory=4Gi)
SANDBOX_CPU=
SANDBOX_MEMORY=

# Qoder CLI 执行器配置(task.executor=qoder_cli 时生效)
# qodercli 可执行文件名/路径(沙箱内 PATH 查找或绝对路径)
# 沙箱镜像预装时填 qodercli;若用其他路径,改这里
QODER_CLI_BIN=qodercli
# qodercli 安装命令(沙箱内未检测到 qodercli 时执行,留空则不自动安装)
# 前提:沙箱镜像已装 Node.js >= 20.0.0(见 docs/opensandbox-deploy.md 2.3 节)
# 推荐在镜像中预装 qodercli,避免每次任务都拉 npm 包(且 BRIDGE_STARTUP_TIMEOUT=30s 可能不够)
QODER_CLI_INSTALL_CMD=npm install -g @qoder-ai/qodercli

# Qoder CN CLI 执行器配置(task.executor=qoder_cli_cn 时生效,国内版/原通义灵码)
# qoderclicn 可执行文件名/路径(与国际版 qodercli 账号体系不互通)
QODER_CLI_CN_BIN=qoderclicn
# qoderclicn 安装命令(官方安装脚本,需沙箱镜像有 curl)
QODER_CLI_CN_INSTALL_CMD=curl -fsSL https://qoder.cn/install | bash

# Kimi Code CLI 执行器配置(task.executor=kimi_cli 时生效,开源 https://github.com/MoonshotAI/kimi-code)
# kimi 可执行文件名/路径(沙箱内 PATH 查找或绝对路径)
# npm 包名 @moonshot-ai/kimi-code,bin 名为 kimi
KIMI_CLI_BIN=kimi
# kimi 安装命令(沙箱内未检测到 kimi 时执行,需沙箱镜像有 Node.js >= 22.19)
# 推荐在镜像中预装 kimi,避免每次任务都拉 npm 包(BRIDGE_STARTUP_TIMEOUT=30s 可能不够)
KIMI_CLI_INSTALL_CMD=npm install -g @moonshot-ai/kimi-code
# 凭证说明:用户在「智能体配置」页面填写 api_key / base_url / model 三个字段,
# 后端经 KIMI_MODEL_* 环境变量族(KIMI_MODEL_API_KEY / KIMI_MODEL_BASE_URL / KIMI_MODEL_NAME)
# 注入到 bridge 进程,CLI 子进程继承后合成临时 provider,无需 config.toml。
# 默认值:KIMI_MODEL_NAME=kimi-for-coding,KIMI_MODEL_PROVIDER_TYPE=kimi(由 registry 注入)
