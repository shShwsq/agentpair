# 阿里云 PostgreSQL 连接串
# 用 psycopg3(SQLAlchemy 2.0 原生支持,无需 pg_config)
# 格式:postgresql+psycopg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+psycopg://username:password@pgm-xxx.pg.rds.aliyuncs.com:5432/agentpair

# 应用配置
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# JWT 密钥(阶段 6 用,先占位)
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 应用基础 URL(用于邮件中的验证/重置链接)
APP_BASE_URL=http://localhost:5173

# GitHub OAuth(阶段 6 用,留空则 /auth/oauth/github 报错)
# 在 https://github.com/settings/developers 创建 OAuth App 获取
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/auth/github/callback

# LLM 配置(阶段 1:开发期写死一个 provider,阶段 6 起用户可配)
# provider id,对应 models_catalog.json 中的 llmProviders[].id
LLM_PROVIDER=dashscope
# API Key(从厂商控制台获取)
LLM_API_KEY=sk-xxxxx
# 模型 id,对应 models_catalog.json 中的 models[].id
LLM_MODEL=qwen3.6-flash
# 是否启用思考(混合思考模型可开关,仅思考模型强制开启)
LLM_ENABLE_THINKING=true

# 仓库克隆临时目录(阶段 1:本地 clone,阶段 2 起改沙箱)
REPO_CLONE_DIR=./_repos

# 沙箱配置(阶段 2 起)
# mode: mock(本地未部署 Server,用本地文件系统模拟)/ sandbox(连真实 OpenSandbox Server)
SANDBOX_MODE=mock
# OpenSandbox Server 地址(部署在 Linux 服务器上)
# 形如 http://your-server-ip:8080
SANDBOX_SERVER_URL=http://localhost:8080
# 沙箱 API Key(可选,若 Server 开启鉴权)
SANDBOX_API_KEY=
# 沙箱镜像(官方 code-interpreter 预装 Python runtime)
SANDBOX_IMAGE=opensandbox/code-interpreter:v1.0.2
# 沙箱超时(分钟)
SANDBOX_TIMEOUT_MINUTES=30
