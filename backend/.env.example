# 阿里云 PostgreSQL 连接串
# 格式:postgresql+psycopg2://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+psycopg2://username:password@pgm-xxx.pg.rds.aliyuncs.com:5432/agentpair

# 应用配置
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# JWT 密钥(阶段 6 用,先占位)
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
